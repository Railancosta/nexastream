# NexaStream Frontend — production configuration template
# Copy values into the deployment environment. Never commit secrets.

NEXT_PUBLIC_DOMAIN=nexastream.org
NEXT_PUBLIC_APP_URL=https://nexastream.org
NEXT_PUBLIC_API_URL=https://api.nexastream.org/api
NEXT_PUBLIC_WS_URL=wss://api.nexastream.org
NEXT_PUBLIC_RPC_URL=https://rpc.nexastream.org
NEXT_PUBLIC_EXPLORER_URL=https://explorer.nexastream.org

# Mainnet identifiers — use only after the corresponding services are live.
NEXT_PUBLIC_CHAIN_ID=1010101
NEXT_PUBLIC_CHAIN_NAME=NexaStream Mainnet
NEXT_PUBLIC_TOKEN_SYMBOL=NST
NEXT_PUBLIC_MAX_SUPPLY=55000000

# Production safety: never enable demo/mock balances or metrics.
NEXT_PUBLIC_DEMO_MODE=false

# Optional integrations. Configure only with real deployed values.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_NST_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_STAKING_ADDRESS=
NEXT_PUBLIC_NFT_ADDRESS=
NEXT_PUBLIC_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_DAO_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=support@nexastream.org
