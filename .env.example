# ===========================================
# NexaStream - Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env e preencha os valores

# ====================
# Segurança (OBRIGATÓRIO)
# ====================
# Chave secreta para JWT (deve ser única e complexa)
JWT_SECRET=your-very-secure-jwt-secret-key-here-change-in-production

# ====================
# CORS (Opcional)
# ====================
# Domínios permitidos para CORS (separados por vírgula)
# Exemplo: http://localhost:3000,https://nexastream.org
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://nexastream.org

# ====================
# Banco de Dados (Opcional)
# ====================
# Caminho para o banco de dados SQLite
# DB_PATH=./database/nexastream.db

# ====================
# Serviços (Opcional)
# ====================
# Porta do serviço de autenticação
AUTH_PORT=3001

# Porta do serviço core
CORE_PORT=3002

# Porta do serviço de vídeos
VIDEOS_PORT=3003

# ====================
# Frontend (Opcional)
# ====================
# Domínio do frontend (para redirecionamento HTTPS)
NEXT_PUBLIC_DOMAIN=nexastream.org

# URL da API
NEXT_PUBLIC_API_URL=http://localhost:3002

# ====================
# Upload (Opcional)
# ====================
# Tamanho máximo de upload (em bytes)
# Default: 100MB (100 * 1024 * 1024)
MAX_UPLOAD_SIZE=104857600

# ====================
# Produção (Opcional)
# ====================
# Modo de produção
NODE_ENV=development

# ====================
# Observabilidade (Opcional)
# ====================
# Porta do serviço de monitoramento
MONITOR_PORT=3010
