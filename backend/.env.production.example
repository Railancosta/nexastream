# NexaStream Backend - Production Environment Variables
# Copy this file to .env for production deployment

# ==========================================
# SERVER CONFIG
# ==========================================

PORT=3001
NODE_ENV=production

# ==========================================
# DATABASE
# ==========================================

# PostgreSQL Connection String
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# ==========================================
# AUTHENTICATION
# ==========================================

# Generate a secure random string (minimum 32 characters)
# Use: openssl rand -hex 32
JWT_SECRET=generate_a_secure_random_string_here_minimum_32_characters

# JWT Expiration times
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ==========================================
# CORS & DOMAINS
# ==========================================

# Production frontend URL (no trailing slash)
FRONTEND_URL=https://nexastream.org

# Allowed origins for CORS
ALLOWED_ORIGINS=https://nexastream.org,https://www.nexastream.org

# ==========================================
# REDIS (Optional - for caching)
# ==========================================

REDIS_URL=redis://localhost:6379

# ==========================================
# STORAGE (Optional - for file uploads)
# ==========================================

# AWS S3 or compatible (MinIO, Cloudflare R2)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=nexastream-uploads
AWS_ENDPOINT=https://s3.amazonaws.com

# ==========================================
# EMAIL (Optional - for notifications)
# ==========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@nexastream.org

# ==========================================
# BLOCKCHAIN / WEB3
# ==========================================

# Blockchain RPC URL
BLOCKCHAIN_RPC_URL=https://rpc.zora.energy

# NST Token Address (after deployment)
NST_TOKEN_ADDRESS=0x...

# Platform wallet address
PLATFORM_WALLET=0x...

# USDC Address (Ethereum Mainnet)
USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# ==========================================
# SECURITY
# ==========================================

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Bcrypt cost factor (higher = more secure but slower)
BCRYPT_ROUNDS=12

# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=info
LOG_FORMAT=json

# ==========================================
# FEATURES
# ==========================================

# Enable/disable features
ENABLE_ANALYTICS=true
ENABLE_LIVESTREAM=true
ENABLE_NFT=true
ENABLE_ADS=true

# ==========================================
# MONETIZATION
# ==========================================

# Revenue split percentages
CREATOR_REVENUE_SHARE=80
PLATFORM_REVENUE_SHARE=20

# Minimum payout in USD
MIN_PAYOUT_USD=1

# ==========================================
# API KEYS
# ==========================================

# Supabase (if using)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# WalletConnect (for Web3 features)
WALLETCONNECT_PROJECT_ID=your_project_id
