# Server
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://nexastream.org

# JWT - IMPORTANT: Change this in Railway dashboard!
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_IN_RAILWAY
JWT_EXPIRES_IN=7d

# Database
DB_PATH=./data/nexastream.db

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=500000000

# Blockchain (Sepolia Testnet - FREE)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/demo
SEPOLIA_CHAIN_ID=11155111
BLOCKCHAIN_NETWORK=sepolia

# Rewards
REWARD_PER_VIEW=0.000001
CREATOR_SHARE=70
PLATFORM_SHARE=30
