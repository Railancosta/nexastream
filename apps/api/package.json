{
  "name": "@nexastream/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "NexaStream REST API v1 — health, version, auth, resumable content-addressed upload.",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "start": "node dist/server.js",
    "dev": "node --watch dist/server.js",
    "migrate": "node dist/db/migrate.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nexastream/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "supertest": "^7.2.2"
  }
}
