FROM node:22-slim
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/shared/ packages/shared/
COPY apps/signaling/ apps/signaling/
RUN corepack enable pnpm && pnpm install --frozen-lockfile=false
RUN pnpm --filter @nexastream/shared run build
RUN pnpm --filter @nexastream/signaling run build
EXPOSE 4010
CMD ["node", "apps/signaling/dist/server.js"]
