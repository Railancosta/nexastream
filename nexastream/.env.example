# Blockchain / Web3
NEXT_PUBLIC_ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-rpc.com
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# USDC Contract Addresses (Mainnet)
NEXT_PUBLIC_USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# Platform Owner Address (for withdrawals)
NEXT_PUBLIC_PLATFORM_OWNER=0xa453B71A216a8A6608e79247B162df47B2770899

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
REFRESH_SECRET=your-refresh-secret-key-change-in-production

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/nexastream

# Redis
REDIS_URL=redis://localhost:6379

# AWS S3 (for video storage)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_REGION=us-east-1
AWS_BUCKET_NAME=nexastream-videos

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_ANALYTICS_API_KEY=YOUR_GOOGLE_ANALYTICS_KEY

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# PIX Integration (Brazil)
PIX_API_KEY=YOUR_PIX_API_KEY
PIX_WEBHOOK_SECRET=YOUR_PIX_WEBHOOK_SECRET

# Node Environment
NODE_ENV=development
