# NexaStream Backend Environment Variables

# Server
PORT=3001
NODE_ENV=production

# JWT
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_IN_PRODUCTION
REFRESH_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_HEX_IN_PRODUCTION
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES=30d

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

SUPABASE_URL=https://bslfsfquympulymbagde.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# POSTGRESQL DATABASE
# ============================================
# From Supabase Dashboard -> Settings -> Database
# Use Connection String (URI) for easiest setup

DB_HOST=db.bslfsfquympulymbagde.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password

# Full connection string (alternative)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.bslfsfquympulymbagde.supabase.co:5432/postgres

# ============================================
# REDIS (Optional)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# ETHEREUM BLOCKCHAIN
# ============================================

# SEPOLIA TESTNET (FREE - get ETH from faucet)
# https://www.alchemy.com/faucets/ethereum-sepolia
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
SEPOLIA_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
SEPOLIA_REWARDS_ADDRESS=0x0000000000000000000000000000000000000000
SEPOLIA_CHAIN_ID=11155111

# ETHEREUM MAINNET (REAL COST - requires real ETH)
# MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# MAINNET_TOKEN_ADDRESS=0x...
# MAINNET_REWARDS_ADDRESS=0x...
# MAINNET_CHAIN_ID=1
# DEPLOYER_PRIVATE_KEY=your_private_key_here

# BLOCKCHAIN SETTINGS
BLOCKCHAIN_NETWORK=sepolia  # Options: sepolia, mainnet, polygon
REWARD_PER_VIEW=0.000001    # NEXA tokens per view
CREATOR_SHARE=70             # % of revenue to creators
PLATFORM_SHARE=30           # % of revenue to platform

# ============================================
# AWS S3 (for file uploads)
# ============================================
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_BUCKET=nexastream-uploads
AWS_REGION=us-east-1

# ============================================
# CLOUDFLARE
# ============================================
CLOUDFLARE_API_TOKEN=your-cloudflare-token
CLOUDFLARE_ZONE_ID=your-zone-id

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ============================================
# TWILIO (SMS)
# ============================================
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE=+1234567890

# ============================================
# FRONTEND URL
# ============================================
FRONTEND_URL=https://nexastream.org

# ============================================
# REWARDS CONFIGURATION
# ============================================
REWARD_PER_VIEW=0.01
CREATOR_SHARE=70
PLATFORM_SHARE=30

# ============================================
# SECURITY-Critical (REQUIRED in production, fail-fast if missing)
# ============================================
# 64 hex chars (32 bytes). AES-256-GCM key for encrypting wallet private keys at rest.
WALLET_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX_IN_PRODUCTION

# Google OAuth (email/password + Google login). Leave empty to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=https://nexastream.org/auth/google/callback

# Google Analytics 4 (Measurement Protocol). Leave empty to disable server-side GA.
GA_MEASUREMENT_ID=
GA_API_SECRET=

# Alerts (automatic operational alerts). Leave empty to only log.
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=

# Blockchain verification / withdrawals. Leave empty to keep deposits pending & withdrawals queued.
BLOCKCHAIN_RPC=
TOKEN_CONTRACT=
TOKEN_DECIMALS=18
DEPOSIT_CONFIRMATIONS=6
