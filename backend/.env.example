# NexaStream Backend Environment Variables

# Server
PORT=3001
NODE_ENV=production

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES=30d

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

SUPABASE_URL=https://bslfsfquympulymbagde.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# POSTGRESQL DATABASE
# ============================================
# From Supabase Dashboard -> Settings -> Database
# Use Connection String (URI) for easiest setup

DB_HOST=db.bslfsfquympulymbagde.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password

# Full connection string (alternative)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.bslfsfquympulymbagde.supabase.co:5432/postgres

# ============================================
# REDIS (Optional)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# BLOCKCHAIN
# ============================================
BLOCKCHAIN_RPC=http://localhost:8545
NFT_CONTRACT=0x...
TOKEN_CONTRACT=0x...

# ============================================
# AWS S3 (for file uploads)
# ============================================
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_BUCKET=nexastream-uploads
AWS_REGION=us-east-1

# ============================================
# CLOUDFLARE
# ============================================
CLOUDFLARE_API_TOKEN=your-cloudflare-token
CLOUDFLARE_ZONE_ID=your-zone-id

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ============================================
# TWILIO (SMS)
# ============================================
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE=+1234567890

# ============================================
# FRONTEND URL
# ============================================
FRONTEND_URL=https://nexastream.org

# ============================================
# REWARDS CONFIGURATION
# ============================================
REWARD_PER_VIEW=0.01
CREATOR_SHARE=70
PLATFORM_SHARE=30
