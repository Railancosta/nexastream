# NexaStream Frontend - Production Environment Variables
# Copy this file to .env.local for production deployment

# ==========================================
# API CONFIGURATION
# ==========================================

# Backend API URL
NEXT_PUBLIC_API_URL=https://api.nexastream.org/api

# WebSocket URL (for real-time features)
NEXT_PUBLIC_WS_URL=wss://api.nexastream.org

# Frontend URL
NEXT_PUBLIC_DOMAIN=nexastream.org
NEXT_PUBLIC_APP_URL=https://nexastream.org

# ==========================================
# BLOCKCHAIN / WEB3
# ==========================================

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Platform owner wallet address
NEXT_PUBLIC_PLATFORM_OWNER=0xYourWalletAddress

# USDC Contract Address (Ethereum Mainnet)
NEXT_PUBLIC_USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# NST Token Address (after deployment)
NEXT_PUBLIC_NST_ADDRESS=0x... (e.g., 0x... on Zora)

# Blockchain Network Configuration
NEXT_PUBLIC_CHAIN_ID=7777777  # Zora mainnet
NEXT_PUBLIC_CHAIN_NAME=Zora
NEXT_PUBLIC_RPC_URL=https://rpc.zora.energy

# ==========================================
# SMART CONTRACTS
# ==========================================

# After deploying smart contracts, add their addresses:
NEXT_PUBLIC_TOKEN_ADDRESS=0x...
NEXT_PUBLIC_STAKING_ADDRESS=0x...
NEXT_PUBLIC_NFT_ADDRESS=0x...
NEXT_PUBLIC_MARKETPLACE_ADDRESS=0x...
NEXT_PUBLIC_DAO_ADDRESS=0x...

# ==========================================
# FEATURES
# ==========================================

# Enable/disable features
NEXT_PUBLIC_ENABLE_LIVESTREAM=true
NEXT_PUBLIC_ENABLE_NFT=true
NEXT_PUBLIC_ENABLE_ADS=true
NEXT_PUBLIC_ENABLE_STAKING=true

# ==========================================
# ANALYTICS
# ==========================================

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog (optional - privacy-friendly analytics)
NEXT_PUBLIC_POSTHOG_KEY=phc_...

# ==========================================
# IPFS / STORAGE
# ==========================================

# Pinata (for IPFS uploads)
NEXT_PUBLIC_PINATA_JWT=your_pinata_jwt

# Web3.Storage
NEXT_PUBLIC_WEB3STORAGE_TOKEN=your_web3storage_token

# ==========================================
# SUPPORT
# ==========================================

# Support email
NEXT_PUBLIC_SUPPORT_EMAIL=support@nexastream.org

# Discord community link
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/nexastream
