# ─────────────────────────────────────────────────────────────
# NexaStream — environment template (NO REAL SECRETS HERE)
# Copy to `.env` and fill in. NEVER commit a populated `.env`.
# ─────────────────────────────────────────────────────────────

# ── API (apps/api) ───────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list of allowed origins for CORS. NEVER use "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# HMAC secret used to sign auth tokens. MUST be high-entropy in production.
JWT_SECRET=change-me-to-a-64-char-random-string

# ── Upload / chunking ────────────────────────────────────────
# Max bytes for a single chunk (8 MiB default).
UPLOAD_CHUNK_SIZE=8388608
# Max total upload size in bytes (default 2 GiB).
UPLOAD_MAX_SIZE=2147483648
# Incomplete uploads are purged after this many seconds (default 24h).
UPLOAD_TTL_SECONDS=86400
# Directory for ephemeral chunked uploads.
UPLOAD_TEMP_DIR=./.data/uploads
# Directory for finalized content-addressed storage.
STORAGE_DIR=./.data/storage

# ── Signaling (apps/signaling) ───────────────────────────────
SIGNALING_PORT=4010
SIGNALING_HOST=0.0.0.0
# Max WebSocket message size in bytes (default 64 KiB).
SIGNALING_MAX_MESSAGE_BYTES=65536
# Max peers per room.
SIGNALING_MAX_PEERS_PER_ROOM=8
# Peer idle timeout in seconds before forced removal.
SIGNALING_PEER_TIMEOUT_SECONDS=60

# ── WebRTC NAT traversal (NEVER hardcode TURN credentials) ────
STUN_URL=stun:stun.l.google.com:19302
# Leave TURN_* empty for local dev; required only when relay is needed.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
